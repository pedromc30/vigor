{
  "expo": {
    "name": "Vigor",
    "slug": "vigor",
    "scheme": "vigor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.vigor.mobile"
    },
    "android": {
      "package": "app.vigor.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#D9502B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1E7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#15120F",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vigor accede a tus fotos solo cuando eliges una para tu progreso.",
          "cameraPermission": "Vigor usa la cámara para hacer tus fotos de progreso y escanear códigos de barras.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Vigor usa la cámara solo para escanear códigos de barras de alimentos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
